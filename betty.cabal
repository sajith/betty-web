cabal-version: >=1.8
name:          betty
version:       0.0.0
build-type:    Simple

flag dev
    description: Turn on development settings, like auto-reload templates.
    default:     False

flag library-only
    description: Build for use with "yesod devel"
    default:     False

library
    exposed-modules:
        Application
        Foundation
        Import
        Model
        Settings
        Betty.SESCreds

    hs-source-dirs:  . app
    other-modules:
        Handler.Home
        Handler.Common
        Handler.Info
        Handler.Info.About
        Handler.Info.Contact
        Handler.Info.Privacy
        Handler.Info.Terms
        Handler.Info.Security
        Handler.Profile
        Handler.ProfileStart
        Handler.ProfileBGUnit
        Handler.AddBG
        Handler.HistoryBG
        Handler.Api
        Handler.Api.V0.Sugar
        Handler.Api.V0.User
        Handler.ResetToken
        Import.NoFoundation
        Settings.StaticFiles
        Betty.Version
        Betty.Signup
        Betty.Signup.MailText
        Betty.Signup.SES
        Betty.Signup.Sendmail
        Betty.Model
        Betty.Helpers
        Betty.Vendor
        Betty.Pid
        Betty.Token
        Betty.Auth
        Betty.DateTime
        Paths_betty

    extensions:
        TemplateHaskell QuasiQuotes OverloadedStrings NoImplicitPrelude CPP
        MultiParamTypeClasses TypeFamilies GADTs GeneralizedNewtypeDeriving
        FlexibleContexts FlexibleInstances EmptyDataDecls
        NoMonomorphismRestriction DeriveDataTypeable ViewPatterns
        TupleSections TypeSynonymInstances NoDisambiguateRecordFields
        NoRecordWildCards

    build-depends:
        base >=4 && <5,
        yesod >=1.4 && <1.5,
        yesod-core -any,
        yesod-auth -any,
        yesod-static -any,
        yesod-form -any,
        classy-prelude-yesod -any,
        bytestring -any,
        text -any,
        persistent -any,
        persistent-postgresql -any,
        persistent-template -any,
        template-haskell -any,
        shakespeare -any,
        hjsmin -any,
        monad-control -any,
        wai-extra -any,
        yaml -any,
        http-conduit -any,
        directory -any,
        warp -any,
        data-default -any,
        aeson -any,
        conduit -any,
        monad-logger -any,
        fast-logger -any,
        wai-logger -any,
        blaze-html -any,
        mime-mail -any,
        mime-mail-ses -any,
        time -any,
        directory -any,
        http-types -any,
        resourcet -any,
        wai -any,
        base64-bytestring -any,
        persistent -any,
        yesod-persistent -any,
        attoparsec -any,
        mwc-random -any,
        vector -any,
        file-embed -any,
        case-insensitive -any,
        gitrev -any

    if (flag(dev) || flag(library-only))
        cpp-options: -DDEVELOPMENT
        ghc-options: -Wall -fwarn-tabs -O0

    else
        cpp-options: -DUSE_AWS_SES
        ghc-options: -Wall -fwarn-tabs -O2

    if !os(windows)
        build-depends: unix -any

executable betty
    main-is:        main.hs
    hs-source-dirs: app
    extensions:
        TemplateHaskell QuasiQuotes OverloadedStrings NoImplicitPrelude CPP
        MultiParamTypeClasses TypeFamilies GADTs GeneralizedNewtypeDeriving
        FlexibleContexts FlexibleInstances EmptyDataDecls
        NoMonomorphismRestriction DeriveDataTypeable ViewPatterns
        TupleSections TypeSynonymInstances NoDisambiguateRecordFields
        NoRecordWildCards

    ghc-options:    -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base -any,
        betty -any,
        foreign-store -any

    if flag(library-only)
        buildable: False

test-suite test
    type:           exitcode-stdio-1.0
    main-is:        Spec.hs
    hs-source-dirs: test
    other-modules:
        HomeSpec
        CommonSpec
        SESSpec
        TestImport
        TestTools
        Handler.ProfileBGUnitSpec

    extensions:
        TemplateHaskell QuasiQuotes OverloadedStrings NoImplicitPrelude CPP
        MultiParamTypeClasses TypeFamilies GADTs GeneralizedNewtypeDeriving
        FlexibleContexts FlexibleInstances EmptyDataDecls
        NoMonomorphismRestriction DeriveDataTypeable ViewPatterns
        TupleSections

    ghc-options:    -Wall
    build-depends:
        base >=4 && <5,
        betty -any,
        yesod-test -any,
        yesod-core -any,
        yesod -any,
        persistent -any,
        persistent-postgresql -any,
        resourcet -any,
        monad-logger -any,
        shakespeare -any,
        transformers -any,
        hspec >=2.0.0,
        classy-prelude -any,
        classy-prelude-yesod -any,
        blaze-html -any,
        mime-mail -any,
        mime-mail-ses -any,
        http-conduit -any,
        http-types -any,
        network-uri -any,
        wai-extra -any,
        bytestring -any,
        text -any
